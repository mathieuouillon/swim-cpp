# Meson/Ninja build output
/build/
/builddir/
build*/

# Large data files and analysis outputs (never commit)
*.hipo
*.root
*.dat
*.evio
*.pdf
*.sqlite

# Meson subprojects: keep the .wrap files, ignore downloaded sources + cache
/subprojects/*/
/subprojects/packagecache/

# Python bytecode cache
__pycache__/
*.pyc

# Editor / OS cruft
.DS_Store
*.swp
*~

# clangd / language-server index
.cache/

# Uv tools
/.uv/
/.venv/
uv.lock

# Local Claude Code tooling config
/.claude/

# Generated outputs: C++ -> output/cpp/, Python -> output/python/<analysis>/
/output/

# Legacy top-level scan/results directories (pre-output/ layout)
dc-x_scan/
dc-z_scan/
dc-y_scan/
solenoid*/
torus*/
zshift_scan*/

# Vendored coatjava trees (3.1G + 819M) - installed, not source
/coatjava/
/coatjava-*/

# Run outputs / scratch
/json/
/log/
/bad.txt
/flagged.txt
/filelist.txt
